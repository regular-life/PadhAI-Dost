services/go-backend/server
services/go-backend/tmp/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# experimental
experimental/

# Agent Runtime State
.agents/